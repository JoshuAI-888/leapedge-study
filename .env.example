# Copy to .env for local development. Never commit configured credentials.
OPENROUTER_API_KEY=
GEMINI_API_KEY=


# YouTube Intelligence local app and worker
YOUTUBE_API_KEY=
# Cumulative USD ceiling for the web pilot, separate from the Python ledger
YTI_BUDGET_USD=2

# Historical market data for creator-performance evaluation
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=

# Optional native-caption provider; native-only retrieval
SUPADATA_API_KEY=

# Hosted single-workspace deployment: set both together; never commit actual values.
YTI_APP_ORIGIN=
YTI_ACCESS_TOKEN=
YTI_PUBLIC_SHARES=false
YTI_BACKUP_DIR=data/backups

# Digest delivery remains disabled until a sender/recipient are authorized.
RESEND_API_KEY=
YTI_EMAIL_TO=
YTI_EMAIL_FROM=
YTI_EMAIL_SEND_ENABLED=false

# Free caption extraction first; no login cookies or paid proxy required.
YTI_YOUTUBEJS_ENABLED=true

# Neon Postgres required on Vercel; omit for local SQLite.
DATABASE_URL=
# Strong random secret for the authenticated Vercel dispatcher.
CRON_SECRET=
# Optional signed delivery-event integration from the Resend dashboard.
RESEND_WEBHOOK_SECRET=
