# Copy to .env for local development. Never commit configured credentials.
# Server environment schema: src/server/youtube-intelligence/env.ts.

# --- Model and data providers (required in production) ---
GEMINI_API_KEY=            # Gemini native transport: extraction, transcription, translation
OPENROUTER_API_KEY=        # critic and context check; also the comparison-week fallback path
YOUTUBE_API_KEY=           # video metadata and channel discovery
TRANSCRIPTAPI_API_KEY=     # caption draft provider
FMP_API_KEY=               # prices, filings, news

# --- Optional providers ---
SUPADATA_API_KEY=          # standby caption/ASR provider behind the circuit breaker
EXA_API_KEY=               # date-bounded web sources for the context check (phase 4)
RESEND_API_KEY=            # digest delivery
RESEND_WEBHOOK_SECRET=     # signed delivery events from the Resend dashboard
YTI_EMAIL_TO=
YTI_EMAIL_FROM=
YTI_EMAIL_SEND_ENABLED=false

# --- Database ---
# Postgres only. Neon issues both endpoints together and they differ by -pooler.
DATABASE_URL=              # POOLED; every Next.js function, including the cron route
DATABASE_URL_UNPOOLED=     # DIRECT; npm run migrate and the maintenance scripts
YTI_PRODUCTION_DB_HOST=    # the production host, so a preview refuses to migrate it
YTI_POOL_MAX=              # clients per serving instance (default 4)
# true drains the queue before a type-changing migration.
YTI_QUEUE_PAUSED=false
# YTI_DB_ROLE=direct forces the direct endpoint; the maintenance scripts already
# ask for it themselves, so this is only an override.
# YTI_DB=pglite runs tests on the Postgres dialect in-process (CI uses this).

# --- Hosted workspace access (set both together) ---
YTI_APP_ORIGIN=            # must equal the deployment alias exactly
YTI_ACCESS_TOKEN=          # strong random secret for signed sessions
YTI_PUBLIC_SHARES=false
# Strong random secret (32+ chars) checked by the Vercel cron dispatcher.
CRON_SECRET=
# Phase 3: HMAC secret for YouTube push notifications (required when channels.discovery=push).
YTI_PUSH_CALLBACK_SECRET=

# --- Spend limits ---
# Cumulative USD ceiling of the legacy ledger (default 2). Raise for production.
YTI_BUDGET_USD=2
# Absolute monthly ceiling the team settings cannot raise (spec 6.1).
YTI_HARD_BUDGET_USD_MONTH=
# Cumulative recorded request-credit cap per caption provider.
YTI_TRANSCRIPT_CREDIT_BUDGET=90
# Opt in to captionless-video generation through the standby provider (2 credits/minute).
YTI_GENERATED_TRANSCRIPTS=false

# --- Local operations ---
YTI_BACKUP_DIR=data/backups
# Lab-only: the legacy whole-video native experiment (audio review). Off by default.
YTI_NATIVE_GOOGLE_ENABLED=false

# Optional stable reviewer identity for this authenticated standalone workspace.
YTI_REVIEWER_ACCOUNT_ID=
# Only use with a dedicated fixture database; visibly labels synthetic data.
YTI_FIXTURE_MODE=false
