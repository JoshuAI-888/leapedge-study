{
  "model": "gemini-3.8-flash",
  "contents": [
    {
      "role": "user",
      "parts": [
        {
          "fileData": {
            "fileUri": "https://www.youtube.com/watch?v=SHMPiWbbR6E"
          }
        },
        {
          "text": "Transcribe ALL speech in its original language into the supplied JSON structure. Use original video absolute times in seconds; preserve words and symbols. video_id: SHMPiWbbR6E"
        }
      ]
    }
  ],
  "config": {
    "maxOutputTokens": 32768,
    "responseMimeType": "application/json",
    "responseJsonSchema": {
