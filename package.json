{
  "name": "youtube-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file=.env --experimental-strip-types scripts/worker.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "eval:replay": "node --experimental-strip-types scripts/evaluate.ts",
    "eval:transcripts": "node --experimental-strip-types scripts/transcript-accuracy.ts",
    "test:captions": "node --experimental-strip-types scripts/caption-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "youtubei.js": "18.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
