{
  "name": "youtube-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "worker": "node --env-file=.env --experimental-strip-types scripts/worker.ts",
    "db:check": "YTI_DB_ROLE=direct node --env-file-if-exists=.env --experimental-strip-types scripts/postgres-check.ts",
    "channels:seed": "YTI_DB_ROLE=direct node --env-file-if-exists=.env --experimental-strip-types scripts/seed-channels.ts",
    "documents:migrate": "YTI_DB_ROLE=direct node --env-file-if-exists=.env --experimental-strip-types scripts/migrate-documents.ts",
    "research:export": "YTI_DB_ROLE=direct node --env-file-if-exists=.env --experimental-strip-types scripts/export-research.ts",
    "research:restore": "YTI_DB_ROLE=direct node --env-file-if-exists=.env --experimental-strip-types scripts/restore-research.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "eval:transcripts": "node --experimental-strip-types scripts/transcript-accuracy.ts",
    "delivery:status": "node --experimental-strip-types scripts/standalone-build.ts status",
    "delivery:next": "node --experimental-strip-types scripts/standalone-build.ts next",
    "delivery:verify": "node --experimental-strip-types scripts/standalone-build.ts verify"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "@vercel/functions": "3.9.8",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
